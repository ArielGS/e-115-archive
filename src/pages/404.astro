---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<!-- One page for both languages: the server cannot know which one was asked for. -->
<Base lang="es" title="404" page="404" path="/404.html" detect={false}>
  <section class="hero" style="min-height:60vh">
    <div class="hero-bg"><img src={url('/images/maps/bo3/the-giant/view-3.webp')} alt="" /></div>
    <div>
      <span class="label">Error 404 // Zona no cartografiada · Uncharted zone</span>
      <h1 class="hero-title glitch" data-text="404">404</h1>
      <p class="hero-sub">Te saliste del mapa. Aquí no hay barricadas, ni perks, ni nadie que te reviva.</p>
      <p class="hero-sub" lang="en">You left the map. No barriers, no perks, no one to revive you.</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href={url('/')} data-sfx>Volver al Archivo</a>
        <a class="btn" href={url('/en/')} hreflang="en" data-sfx>Back to the Archive</a>
      </div>
    </div>
  </section>
</Base>
