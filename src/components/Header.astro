---
import { getCollection } from 'astro:content';
import { url } from '../lib/site';
import ZombieEye from './ZombieEye.astro';
import { baseId, byOrder, entryLang } from '../lib/maps';
import { LANGS, localePath, pagePath, t, tList, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  current?: string;
  alternates: Record<string, string>;
}
const { lang, current, alternates } = Astro.props;

// One "Games" chip opens a menu with every era, instead of one chip per game.
const eras = (await getCollection('eras', (e) => entryLang(e) === lang)).sort(byOrder);
const inGame = eras.some((e) => baseId(e) === current);

const before = [
  { id: 'home', href: localePath(lang, '/'), label: t(lang, 'nav.home') },
  { id: 'story', href: pagePath(lang, 'story'), label: t(lang, 'nav.story') },
  { id: 'quests', href: pagePath(lang, 'quests'), label: t(lang, 'nav.quests') },
];
const after = [
  { id: 'contribute', href: pagePath(lang, 'contribute'), label: t(lang, 'nav.contribute') },
  { id: 'credits', href: pagePath(lang, 'credits'), label: t(lang, 'nav.credits') },
];
const ticker = tList(lang, 'ticker');
---

<header class="site-header">
  <div class="brand">
    <ZombieEye label={t(lang, 'logo.eye')} class="logo-eye" />
    <a class="logo" href={url(localePath(lang, '/'))} data-sfx aria-label={t(lang, 'logo.home')}>
      <span class="logo-text">{t(lang, 'site.word')} <b>115</b></span>
    </a>
  </div>
  <div class="lang-switch" role="group" aria-label={t(lang, 'nav.lang')}>
    {
      LANGS.map((l) => (
        <a
          href={alternates[l]}
          hreflang={l}
          lang={l}
          data-lang-switch={l}
          data-sfx
          aria-current={l === lang ? 'true' : undefined}
          title={l === 'es' ? 'Español' : 'English'}
        >
          {l.toUpperCase()}
        </a>
      ))
    }
  </div>
  <nav class="main-nav" aria-label={t(lang, 'nav.label')}>
    {
      before.map((l) => (
        <a class="chip" href={url(l.href)} data-sfx aria-current={current === l.id ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <!-- Without JavaScript this is a plain link to the game tabs; the script
         turns it into a button that opens the menu below. -->
    <a
      class="chip nav-games"
      href={url(localePath(lang, '/#eras'))}
      data-games-toggle
      aria-controls="games-menu"
      aria-expanded="false"
      aria-current={inGame ? 'page' : undefined}
      data-sfx
    >
      {t(lang, 'nav.games')} <span class="caret" aria-hidden="true">▾</span>
    </a>
    {
      after.map((l) => (
        <a class="chip" href={url(l.href)} data-sfx aria-current={current === l.id ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <button type="button" class="chip chip-btn" data-sound-toggle data-sfx aria-pressed="false">
      {t(lang, 'nav.sound')}: <span data-sound-label>OFF</span>
    </button>
  </nav>
  <div class="games-menu" id="games-menu" data-games-menu hidden>
    <span class="label">{t(lang, 'nav.gamesLabel')}</span>
    <ul>
      {
        eras.map((e) => (
          <li>
            <a
              class="chip"
              href={url(localePath(lang, `/#${baseId(e)}`))}
              data-game={baseId(e)}
              style={`--t:${e.data.accent}`}
              aria-current={current === baseId(e) ? 'true' : undefined}
              data-sfx
            >
              <span class="code">{e.data.code}</span>
              <span class="title">{e.data.title}</span>
              <span class="year">{e.data.year}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[...ticker, ...ticker].map((line) => <span>{line}</span>)}
  </div>
</div>
