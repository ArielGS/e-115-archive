---
// The zombie eye (behaviour in src/scripts/zombie-eye.ts, styles in
// src/styles/chrome.css). With a `label` it is the header logo: a button, so
// it can be woken up from the keyboard too, while the "ARCHIVO 115" text next
// to it stays the link home. Without one it is decorative (the Flash intro).
// `prefix` keeps the SVG ids unique when both are on the same page.
interface Props {
  label?: string;
  prefix?: string;
  class?: string;
}
const { label, prefix = 'ze', class: className } = Astro.props;
const id = (name: string) => `${prefix}-${name}`;
const ref = (name: string) => `url(#${id(name)})`;
const Tag = label ? 'button' : 'div';
const attrs = label ? { type: 'button', 'data-zombie-eye': '', 'aria-label': label, title: label } : { 'aria-hidden': 'true' };
// Short, ragged lashes along the upper lid's edge: [x, y, slant, length].
const lashes = [
  [9, 12.2, -1, 2.4],
  [13.5, 12.9, -0.8, 1.6],
  [18, 13.3, -0.4, 2.6],
  [22.5, 13.5, 0, 1.9],
  [27, 13.45, 0.3, 2.7],
  [31.5, 13.2, 0.7, 1.7],
  [36, 12.7, 0.9, 2.3],
  [40, 12.1, 1.1, 1.5],
];
const almond = 'M3 20Q24 0 45 20Q24 40 3 20Z';
// The rotting skin around it: a slightly bigger almond, so the glow (a
// drop-shadow) takes the shape of the eye instead of a round halo.
const socket = 'M0.5 20Q24-5.5 47.5 20Q24 45.5 0.5 20Z';
---

<Tag class:list={['zombie-eye', className]} {...attrs}>
  <svg class="ze" viewBox="0 0 48 40" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id={id('skin')} cx=".45" cy=".4" r=".65">
        <stop offset="0" stop-color="#55653f" />
        <stop offset=".55" stop-color="#2c3620" />
        <stop offset="1" stop-color="#0f140b" />
      </radialGradient>
      <radialGradient id={id('sclera')} cx=".5" cy=".5" r=".55">
        <stop offset="0" stop-color="#fff3c2" />
        <stop offset=".45" stop-color="#e6d085" />
        <stop offset=".8" stop-color="#a87f36" />
        <stop offset="1" stop-color="#4d1f10" />
      </radialGradient>
      <radialGradient id={id('iris-fill')} cx=".42" cy=".4" r=".62">
        <stop offset="0" stop-color="#fffbb0" />
        <stop offset=".3" stop-color="#ffd23f" />
        <stop offset=".7" stop-color="#ff7a18" />
        <stop offset="1" stop-color="#7a1600" />
      </radialGradient>
      <radialGradient id={id('flare-fill')}>
        <stop offset="0" stop-color="#ff2a3d" stop-opacity="0" />
        <stop offset=".55" stop-color="#ff2a3d" stop-opacity=".35" />
        <stop offset="1" stop-color="#ff0016" stop-opacity=".9" />
      </radialGradient>
      <linearGradient id={id('lid-top')} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1c2414" />
        <stop offset=".8" stop-color="#4a5938" />
        <stop offset="1" stop-color="#2a1610" />
      </linearGradient>
      <linearGradient id={id('lid-bottom')} x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#1c2414" />
        <stop offset=".85" stop-color="#435233" />
        <stop offset="1" stop-color="#3a1712" />
      </linearGradient>
      <clipPath id={id('clip')}>
        <path d={almond} />
      </clipPath>
    </defs>

    <!-- rotting skin, a stitched scar across it and the eye's own shadow -->
    <path d={socket} fill={ref('skin')} />
    <path class="ze-scar" d="M9 13.9 15.4 10.3M10.2 12.2l1 2.1M12 11.2l1 2.1M13.8 10.2l1 2.1" />
    <path d={almond} fill="none" stroke="#000" stroke-opacity=".6" stroke-width="3" />

    <g clip-path={ref('clip')}>
      <path d={almond} fill={ref('sclera')} />
      <g class="ze-veins">
        <path d="M3.5 19.5Q9 17.6 13 19.4Q15 18.3 16.6 18.9" />
        <path d="M4.5 21.2Q10 23.2 13.6 21.9" />
        <path d="M44.5 19.8Q39 17.4 35 19Q33 17.9 31.4 18.4" />
        <path d="M43.6 21.6Q38 24.2 34.4 22.6" />
        <path d="M19.4 11.4Q21 14 20.4 15.6" />
        <path d="M28.6 28.8Q27 26 28.2 24.4" />
      </g>
      <g class="ze-iris">
        <g class="ze-iris-core">
          <circle cx="24" cy="20" r="8.6" fill={ref('iris-fill')} />
          <path class="ze-fibers" d="M24 12.2V15M24 25v2.8M16.2 20H19M29 20h2.8M18.5 14.5l2 2M27.5 23.5l2 2M29.5 14.5l-2 2M18.5 25.5l2-2" />
          <circle cx="24" cy="20" r="8.6" fill="none" stroke="#3a0a00" stroke-width=".9" />
          <g class="ze-pupil-wrap">
            <ellipse class="ze-pupil" cx="24" cy="20" rx="2.4" ry="5" fill="#0b0300" />
          </g>
          <circle class="ze-flare" cx="24" cy="20" r="9" fill={ref('flare-fill')} />
        </g>
      </g>
      <!-- the light does not move with the iris -->
      <circle cx="21" cy="16.2" r="1.5" fill="#fff" opacity=".85" />
      <circle cx="26.6" cy="23.2" r=".6" fill="#fff" opacity=".45" />
      <g class="ze-lid ze-lid-top">
        <path d="M-1-24H49V10Q24 17-1 10Z" fill={ref('lid-top')} />
        <path d="M-1 10Q24 17 49 10" fill="none" stroke="#120500" stroke-width="1.2" />
        <path class="ze-lashes" d={lashes.map(([x, y, s, l]) => `M${x} ${y}l${s} ${l}`).join('')} />
      </g>
      <g class="ze-lid ze-lid-bottom">
        <path d="M-1 64H49V29Q24 24-1 29Z" fill={ref('lid-bottom')} />
        <path d="M-1 29Q24 24 49 29" fill="none" stroke="#120500" stroke-width=".9" />
      </g>
    </g>
    <!-- wet, raw rim -->
    <path d={almond} fill="none" stroke="#5a0f12" stroke-width="1.3" />
  </svg>
</Tag>
