---
import { t, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  lang: Lang;
}
const { title, lang } = Astro.props;
---

<button type="button" class="narrator-fab" data-narrator-open aria-expanded="false" aria-controls="narrator" data-sfx>
  <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
  {t(lang, 'narrator.open')}
</button>

<aside class="narrator" id="narrator" data-narrator aria-label={t(lang, 'narrator.label')}>
  <div class="narrator-top">
    <span class="label">{t(lang, 'narrator.title')} // {title}</span>
    <button
      type="button"
      class="narrator-close narrator-min"
      data-n-min
      aria-expanded="true"
      aria-controls="narrator"
      aria-label={t(lang, 'narrator.minimize')}
      title={t(lang, 'narrator.minimize')}
    >
      <svg class="i-min" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 17h14v3H5z"></path></svg>
      <svg class="i-max" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 8v9h8V8z"></path></svg>
    </button>
    <button type="button" class="narrator-close" data-n-close aria-label={t(lang, 'narrator.close')} title={t(lang, 'narrator.close')}>✕</button>
  </div>
  <div class="narrator-screen">
    <canvas data-n-scope width="340" height="46" aria-hidden="true"></canvas>
    <div class="narrator-status"><span data-n-status role="status">{t(lang, 'narrator.ready')}</span><span data-n-count>00/00</span></div>
    <p class="narrator-now" data-n-now aria-live="off"></p>
  </div>
  <div class="narrator-controls">
    <button type="button" class="n-btn" data-n-prev aria-label={t(lang, 'narrator.prev')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z"></path></svg>
    </button>
    <button type="button" class="n-btn" data-n-play aria-label={t(lang, 'narrator.play')} data-state="play">
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"></path></svg>
    </button>
    <button type="button" class="n-btn" data-n-next aria-label={t(lang, 'narrator.next')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z"></path></svg>
    </button>
    <button type="button" class="n-btn" data-n-stop aria-label={t(lang, 'narrator.stop')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6h12v12H6z"></path></svg>
    </button>
  </div>
  <div class="narrator-settings">
    <label class="wide">{t(lang, 'narrator.voice')} <select data-n-voice aria-label={t(lang, 'narrator.voice')}></select></label>
    <label>
      {t(lang, 'narrator.speed')}
      <select data-n-rate aria-label={t(lang, 'narrator.speed')}>
        <option value="0.85">{t(lang, 'narrator.slow')}</option>
        <option value="1" selected>{t(lang, 'narrator.normal')}</option>
        <option value="1.15">{t(lang, 'narrator.fast')}</option>
        <option value="1.3">{t(lang, 'narrator.faster')}</option>
      </select>
    </label>
    <div style="display:grid;gap:6px;align-content:end">
      <label class="check"><input type="checkbox" data-n-ambient checked /> {t(lang, 'narrator.ambient')}</label>
      <label class="check"><input type="checkbox" data-n-follow checked /> {t(lang, 'narrator.follow')}</label>
      <label class="check"><input type="checkbox" data-n-recording checked /> {t(lang, 'narrator.recording')}</label>
    </div>
  </div>
  <p class="narrator-hint">{t(lang, 'narrator.hint')}</p>
  <p class="narrator-hint" data-n-voice-tip hidden>{t(lang, 'narrator.voiceTip')}</p>
</aside>
