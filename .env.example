# Repository behind the "contribute" and "edit this page" links. Defaults to the
# official one (https://github.com/ArielGS/e-115-archive); forks set their own URL here.
PUBLIC_REPO_URL=https://github.com/ArielGS/e-115-archive
# Base path when hosting under a sub-folder (GitHub Pages: /<repo>/)
BASE_PATH=/
SITE_URL=http://localhost:4321
# Free search engine verification ("HTML tag" method): paste only the content="…" code.
# Google Search Console: https://search.google.com/search-console  ·  Bing: https://www.bing.com/webmasters
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
