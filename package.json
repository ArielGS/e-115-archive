{
  "name": "archivo-115",
  "version": "1.0.0",
  "private": true,
  "description": "Spoiler-safe, Flash-era styled field guide to Call of Duty Zombies. Content lives in Markdown.",
  "license": "MIT AND CC-BY-SA-4.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && start-server-and-test preview http://localhost:4321 cy:run",
    "cy:run": "node scripts/cypress.mjs run",
    "cy:open": "node scripts/cypress.mjs open",
    "images": "node scripts/fetch-images.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "astro": "^7.3.6",
    "remark-directive": "^4.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "cypress": "^16.1.1",
    "jsdom": "^30.1.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "start-server-and-test": "^3.0.12",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
